<?xml version="1.0"?>
<!-- Phase 3 scenario obstacle. Spawned at runtime, so no world file is
     modified and the static map never contains it. -->
<sdf version="1.9">
  <model name="wall_020x200">
    <static>true</static>
    <link name="link">
      <collision name="c"><geometry><box><size>0.2 2.0 1.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 2.0 1.2</size></box></geometry>
        <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
