<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET was missing, so socket creation threw before a packet could
      leave the device. Added for the /ws/video uplink.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      RECORD_AUDIO was declared but nothing in the app records audio: there is
      no MediaRecorder, no AudioRecord, and camera-video is deliberately not a
      dependency. Requesting a permission the app cannot use is a needless
      privacy ask and a Play policy problem, so it was removed.
    -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FYP3D"
        tools:targetApi="37"
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
          networkSecurityConfig resolves to DIFFERENT resources per build type
          by source-set overlay:

            app/src/main/res/xml/network_security_config.xml   cleartext DENIED
            app/src/debug/res/xml/network_security_config.xml  cleartext allowed

          The debug source set overrides main, so the release build inherits
          the deny-by-default policy from main and no blanket
          android:usesCleartextTraffic is used anywhere. See the comments in
          both files for why cleartext is needed at all.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FYP3D"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
